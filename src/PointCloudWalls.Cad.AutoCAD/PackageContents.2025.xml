        <Command Local="PCWLISTEN" Global="PCWLISTEN" />
        <Command Local="PCWSTOP" Global="PCWSTOP" />
        <Command Local="PCWSTATUS" Global="PCWSTATUS" />
        <Command Local="PCWCLEAR" Global="PCWCLEAR" />
      </Commands>
    </ComponentEntry>
  </Components>
</ApplicationPackage>
